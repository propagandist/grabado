<?xml version="1.0" encoding="utf-8" ?>
<!--
  特性化テスト fixture: db/oracle/datatypes.xml の型パレットを網羅する（15 型）。
  サイズ付き（length="1"）の型は括弧つきで書き、Row.fromXML のサイズ抽出も通す。

  **1 列 = パレットの 1 型**で、書く型名はパレットの sql 属性そのもの。
  網羅は tests/node/fixture-set.test.ts が機械的に見るので、6-8 でパレットを
  現代化したときの入れ忘れ・消し忘れがその場で赤くなる。

  **c_integer だけは書いた型に解決しない**（known-issue #10）—— number の re="INT" が
  integer の sql 完全一致を後勝ちで上書きするので NUMBER になる。**この 1 列が
  「入力は網羅しているが解決は壊れている」ことの実物**で、6-8 で直ると golden が動く。
-->
<sql>
<table x="20" y="20" name="type_samples">
<row name="c_integer" null="1" autoincrement="0">
<datatype>INTEGER</datatype>
</row>
<row name="c_number" null="0" autoincrement="0">
<datatype>NUMBER(10)</datatype>
</row>
<row name="c_char" null="1" autoincrement="0">
<datatype>CHAR(10)</datatype>
</row>
<row name="c_varchar2" null="1" autoincrement="0">
<datatype>VARCHAR2(255)</datatype>
</row>
<row name="c_clob" null="1" autoincrement="0">
<datatype>CLOB</datatype>
</row>
<row name="c_nchar" null="1" autoincrement="0">
<datatype>NCHAR(10)</datatype>
</row>
<row name="c_nvarchar2" null="1" autoincrement="0">
<datatype>NVARCHAR2(255)</datatype>
</row>
<row name="c_nclob" null="1" autoincrement="0">
<datatype>NCLOB</datatype>
</row>
<row name="c_date" null="1" autoincrement="0">
<datatype>DATE</datatype>
</row>
<row name="c_timestamp" null="1" autoincrement="0">
<datatype>TIMESTAMP(6)</datatype>
</row>
<row name="c_raw" null="1" autoincrement="0">
<datatype>RAW(16)</datatype>
</row>
<row name="c_blob" null="1" autoincrement="0">
<datatype>BLOB</datatype>
</row>
<row name="c_decimal" null="1" autoincrement="0">
<datatype>DECIMAL(12,2)</datatype>
</row>
<row name="c_float" null="1" autoincrement="0">
<datatype>FLOAT(10)</datatype>
</row>
<row name="c_double_precision" null="1" autoincrement="0">
<datatype>DOUBLE PRECISION</datatype>
</row>
<key type="PRIMARY" name="type_samples_pkey">
<part>c_number</part>
</key>
</table>
</sql>
