<?xml version="1.0" encoding="utf-8" ?>
<!--
  特性化テスト fixture: house 既定（HANDOVER §6）に沿ったスキーマ。
  docs/samples/introspection-sample-schema.sql を設計 XML として書き起こしたもの。
  uuidv7 PK / timestamptz 監査列 / jsonb / 複合 PK / UNIQUE / FK / 日本語コメントを含む。

  注意: 現行の db/postgresql/datatypes.xml に uuid 型は無い。UUID は型パレットに
  一致せず先頭の型（INTEGER）へ黙って落ちる。これは現行の実挙動であり、
  HANDOVER §6.1 の型パレット差し替えで解消される対象。golden がその変化を捉える。
-->
<sql>
<table x="20" y="20" name="users">
<row name="id" null="0" autoincrement="0">
<datatype>UUID</datatype>
<default>uuidv7()</default>
</row>
<row name="email" null="0" autoincrement="0">
<datatype>TEXT</datatype>
<comment>ログイン用メールアドレス</comment>
</row>
<row name="display_name" null="0" autoincrement="0">
<datatype>TEXT</datatype>
</row>
<row name="is_active" null="0" autoincrement="0">
<datatype>BOOLEAN</datatype>
<default>true</default>
</row>
<row name="preferences" null="0" autoincrement="0">
<datatype>JSONB</datatype>
<default>'{}'::jsonb</default>
<comment>UI 設定などの任意項目</comment>
</row>
<row name="created_at" null="0" autoincrement="0">
<datatype>TIMESTAMP WITH TIME ZONE</datatype>
<default>now()</default>
</row>
<row name="updated_at" null="0" autoincrement="0">
<datatype>TIMESTAMP WITH TIME ZONE</datatype>
<default>now()</default>
</row>
<key type="PRIMARY" name="users_pkey">
<part>id</part>
</key>
<key type="UNIQUE" name="users_email_key">
<part>email</part>
</key>
<comment>ユーザー</comment>
</table>
<table x="420" y="20" name="articles">
<row name="id" null="0" autoincrement="0">
<datatype>UUID</datatype>
<default>uuidv7()</default>
</row>
<row name="author_id" null="0" autoincrement="0">
<datatype>UUID</datatype>
<relation table="users" row="id" />
<comment>執筆者 (users.id)</comment>
</row>
<row name="title" null="0" autoincrement="0">
<datatype>TEXT</datatype>
</row>
<row name="body" null="1" autoincrement="0">
<datatype>TEXT</datatype>
</row>
<row name="view_count" null="0" autoincrement="0">
<datatype>INTEGER</datatype>
<default>0</default>
</row>
<row name="price" null="1" autoincrement="0">
<datatype>DECIMAL(12,2)</datatype>
<comment>有料記事の価格。money ではなく numeric を使う</comment>
</row>
<row name="published_on" null="1" autoincrement="0">
<datatype>DATE</datatype>
</row>
<row name="created_at" null="0" autoincrement="0">
<datatype>TIMESTAMP WITH TIME ZONE</datatype>
<default>now()</default>
</row>
<row name="updated_at" null="0" autoincrement="0">
<datatype>TIMESTAMP WITH TIME ZONE</datatype>
<default>now()</default>
</row>
<key type="PRIMARY" name="articles_pkey">
<part>id</part>
</key>
<comment>記事</comment>
</table>
<table x="820" y="20" name="article_tags">
<row name="article_id" null="0" autoincrement="0">
<datatype>UUID</datatype>
<relation table="articles" row="id" />
</row>
<row name="tag" null="0" autoincrement="0">
<datatype>TEXT</datatype>
</row>
<row name="created_at" null="0" autoincrement="0">
<datatype>TIMESTAMP WITH TIME ZONE</datatype>
<default>now()</default>
</row>
<key type="PRIMARY" name="pk_article_tags">
<part>article_id</part>
<part>tag</part>
</key>
<comment>記事とタグの対応</comment>
</table>
</sql>
