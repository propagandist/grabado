# git hook / シェルスクリプトは LF 固定（Windows でも shebang を壊さない）
.githooks/** text eol=lf
scripts/*.sh text eol=lf

# PowerShell は Windows ネイティブなので CRLF
scripts/*.ps1 text eol=crlf

# 特性化テスト（HANDOVER §7）の入力 fixture と golden は LF 固定。
# バイト一致で比較するため、チェックアウト時の改行変換を絶対に許さない。
tests/fixtures/** text eol=lf
tests/golden/**   text eol=lf

# db/*/output.xsl の xsl:text 内の改行はそのまま生成 SQL に出る。
# つまり db/ の改行コードが golden のバイト列を左右する。改行を変換せず
# 「コミットされたバイトのまま」チェックアウトさせることで、どの環境でも golden が一致する。
# （唯一 CRLF だった db/vfp9/output.xsl は段階6-1 で消えたが、環境依存の変換を
#  挟まないという保証のほうが強いので -text は残す。db/ に何を置くかは
#  output.xsl が TS 生成器になる 6-5 で決め直す。locale/ko.xml は今も CRLF。）
db/**     -text
locale/** -text
