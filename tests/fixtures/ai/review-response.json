    "patch": { "op": "change-type", "sqlType": "UUID" }
  },
  {
    "category": "type_smell",
    "severity": "warn",
    "target": { "table": "employees", "column": "id" },
    "rationale": "uuid の PK は DEFAULT uuidv7() を持たせる（house 既定）。時系列で単調増加するので btree が劣化しない。",
    "patch": { "op": "set-default", "value": "uuidv7()" }
  },
  {
    "category": "missing_audit",
    "severity": "warn",
