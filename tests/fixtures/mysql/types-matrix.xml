<?xml version="1.0" encoding="utf-8" ?>
<!--
  特性化テスト fixture: db/mysql/datatypes.xml の型パレットを網羅する（23 型）。
  サイズ付き（length="1"）の型は括弧つきで書き、Row.fromXML のサイズ抽出も通す。

  **1 列 = パレットの 1 型**で、書く型名はパレットの sql 属性そのもの。
  網羅は tests/node/fixture-set.test.ts が機械的に見るので、6-8 でパレットを
  現代化したときの入れ忘れ・消し忘れがその場で赤くなる。

  bit だけ小文字なのは **db/mysql/datatypes.xml の sql が小文字 "bit" だから**。
  未現代化プロファイルの照合は大文字小文字を区別する完全一致なので、BIT と書くと
  どの型にも当たらず先頭型（integer）に落ちる（known-issue #4 / #10）。
  6-8 で strict になると大小無視の照合になり、この 1 行が普通に書けるようになる。
-->
<sql>
<table x="20" y="20" name="type_samples">
<row name="c_integer" null="1" autoincrement="0">
<datatype>INTEGER</datatype>
</row>
<row name="c_tinyint" null="1" autoincrement="0">
<datatype>TINYINT</datatype>
</row>
<row name="c_smallint" null="1" autoincrement="0">
<datatype>SMALLINT</datatype>
</row>
<row name="c_mediumint" null="1" autoincrement="0">
<datatype>MEDIUMINT</datatype>
</row>
<row name="c_int" null="0" autoincrement="0">
<datatype>INT</datatype>
</row>
<row name="c_bigint" null="1" autoincrement="0">
<datatype>BIGINT</datatype>
</row>
<row name="c_decimal" null="1" autoincrement="0">
<datatype>DECIMAL(12,2)</datatype>
</row>
<row name="c_float" null="1" autoincrement="0">
<datatype>FLOAT</datatype>
</row>
<row name="c_double" null="1" autoincrement="0">
<datatype>DOUBLE</datatype>
</row>
<row name="c_char" null="1" autoincrement="0">
