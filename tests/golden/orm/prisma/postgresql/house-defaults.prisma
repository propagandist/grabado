// grabado が生成した Prisma のスキーマ。
//
// **native type 属性（@db.Uuid / @db.VarChar）は出さない** —— provider ごとに別の表が
// 要り、正規型 1 段で写すという設計（段階6-9c）と噛み合わないため。uuid は String に、
// date / time / timestamp は DateTime に丸まる。丸めた列にはその旨のコメントが付く。
//
// **Prisma の識別子は ASCII だけ**なので、非 ASCII の名前は `_` に潰して通し番号で
// 一意化してある。**元の名前は @@map / @map に必ず残る**。

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// ユーザー
model User {
  id String @id @default(dbgenerated("uuidv7()"))
  /// ログイン用メールアドレス
  email String
  displayName String @map("display_name")
  isActive Boolean @default(true) @map("is_active")
  /// UI 設定などの任意項目
  preferences Json @default(dbgenerated("'{}'::jsonb"))
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  articles Article[]

  @@unique([email], map: "users_email_key")
  @@map("users")
}

/// 記事
model Article {
  id String @id @default(dbgenerated("uuidv7()"))
  /// 執筆者 (users.id)
  authorId String @map("author_id")
  author User @relation(fields: [authorId], references: [id])
  title String
  body String?
  viewCount Int @default(0) @map("view_count")
  /// 有料記事の価格。money ではなく numeric を使う
  price Decimal?
  publishedOn DateTime? @map("published_on")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  articleTags ArticleTag[]

  @@map("articles")
}

/// 記事とタグの対応
model ArticleTag {
  articleId String @map("article_id")
  article Article @relation(fields: [articleId], references: [id])
  tag String
  createdAt DateTime @default(now()) @map("created_at")

  @@id([articleId, tag])
  @@map("article_tags")
}