<?xml version="1.0" encoding="utf-8" ?>
<!--
  特性化テスト fixture: db/sqlite/datatypes.xml の型パレットを網羅する（5 型）。

  **SQLite のパレットは「型」ではなく型親和性（type affinity）の 5 つ**で、他プロファイルの
  ように型名が並んでいるわけではない。5 列で全部というのがこの DB の実際の姿で、
  列数の少なさそのものが「SQLite で設計するとは何か」を示している。

  **1 列 = パレットの 1 型**で、書く型名はパレットの sql 属性そのもの。
  網羅は tests/node/fixture-set.test.ts が機械的に見るので、6-8 でパレットを
  現代化したときの入れ忘れ・消し忘れがその場で赤くなる。

  TEXT だけが length="1" なのでサイズを書ける（SQLite は括弧の中身を無視するが、
  親和性の判定には使う）。
-->
<sql>
<table x="20" y="20" name="type_samples">
<row name="c_text" null="1" autoincrement="0">
<datatype>TEXT(255)</datatype>
</row>
<row name="c_numeric" null="1" autoincrement="0">
<datatype>NUMERIC</datatype>
</row>
<row name="c_integer" null="0" autoincrement="0">
<datatype>INTEGER</datatype>
</row>
<row name="c_real" null="1" autoincrement="0">
<datatype>REAL</datatype>
</row>
<row name="c_none" null="1" autoincrement="0">
<datatype>NONE</datatype>
</row>
<key type="PRIMARY" name="type_samples_pkey">
<part>c_integer</part>
</key>
</table>
</sql>
