{
  "name": "grabado",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "grabado — ER 設計ツール（wwwsqldesigner 由来）。本 package.json は HANDOVER §7 特性化テストの基盤。",
  "license": "BSD-3-Clause",
  "scripts": {
    "test": "vitest run",
    "test:browser": "playwright test --project=characterization",
    "test:all": "npm run test:browser && npm run test",
    "golden:update": "cross-env UPDATE_GOLDEN=1 playwright test --project=characterization",
    "known-issues": "playwright test --project=known-issues",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "xslt-processor": "^5.1.0"
  }
}
