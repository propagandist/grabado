<?xml version="1.0" encoding="utf-8" ?>
<!--
  特性化テスト fixture: db/mssql/datatypes.xml の型パレットを網羅する（26 型）。
  サイズ付き（length="1"）の型は括弧つきで書き、Row.fromXML のサイズ抽出も通す。

  **1 列 = パレットの 1 型**で、書く型名はパレットの sql 属性そのもの。
  網羅は tests/node/fixture-set.test.ts が機械的に見るので、6-8 でパレットを
  現代化したときの入れ忘れ・消し忘れがその場で赤くなる。

  **型名がすべて小文字なのは db/mssql/datatypes.xml の sql が小文字だから。**
  未現代化プロファイルの照合は大文字小文字を区別する完全一致なので、これで 26 型とも
  書いた型に解決する。**大文字で INT と書くと re="INT" が 4 型（tinyint / smallint /
  int / bigint）に部分一致して後勝ちで bigint になる**（known-issue #10）。
  6-8 で strict になると大小無視の照合になり、どちらで書いても同じになる。
-->
<sql>
<table x="20" y="20" name="type_samples">
<row name="c_tinyint" null="1" autoincrement="0">
<datatype>tinyint</datatype>
</row>
<row name="c_smallint" null="1" autoincrement="0">
<datatype>smallint</datatype>
</row>
<row name="c_int" null="0" autoincrement="0">
<datatype>int</datatype>
</row>
<row name="c_bigint" null="1" autoincrement="0">
<datatype>bigint</datatype>
</row>
<row name="c_money" null="1" autoincrement="0">
<datatype>money</datatype>
</row>
<row name="c_smallmoney" null="1" autoincrement="0">
<datatype>smallmoney</datatype>
</row>
<row name="c_real" null="1" autoincrement="0">
<datatype>real</datatype>
</row>
<row name="c_float" null="1" autoincrement="0">
<datatype>float</datatype>
</row>
<row name="c_decimal" null="1" autoincrement="0">
<datatype>decimal(12,2)</datatype>
</row>
<row name="c_numeric" null="1" autoincrement="0">
<datatype>numeric(18,4)</datatype>
</row>
<row name="c_char" null="1" autoincrement="0">
<datatype>char</datatype>
</row>
<row name="c_varchar" null="1" autoincrement="0">
<datatype>varchar(255)</datatype>
</row>
<row name="c_text" null="1" autoincrement="0">
