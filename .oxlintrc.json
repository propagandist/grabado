{
    "$schema": "./node_modules/oxlint/configuration_schema.json",

    // ★ 閾値（--max-warnings）はここには書けない。package.json の lint スクリプトが持つ。
    //   2026-09-16 の実測は **650 件**（no-var 563 / no-redeclare 44 / no-unused-vars 43 /
    //   no-implicit-globals 0。177 ファイル）。**650 で緑、649 で赤**になることを両方確かめてある。
    //   #321 が var を潰したら、**実測値まで閾値を下げること** —— 上限は減ったときに赤くならない。
    //
    // 既定で入る correctness カテゴリを切り、規則は 4 つで始める（#316）。
    // 推奨セットを丸ごと入れると、本来見たい no-var が埋もれる。規則は必要になった時点で足す。
    //
    // ★ 実測（2026-09-16）—— 切った correctness は **5 件しか出さず、うち 2 件が本物だった**
    //   （drizzle.ts:562 のエスケープが効いていない ／ styles.test.ts:194 のテンプレートリテラル
    //   内の \s が s に潰れている）。**「数百件出て埋もれる」は起きていない。**
    //   それでもこの版では切ったままにする —— 直すには io.ts を触ることになり、
    //   #321 → #312 の順序（CUSTOMIZATIONS.md の 2026-09-16）を跨ぐため。
    //   拾い直しは #347。drizzle の 1 件は #346（出力バイト列に関わるので分けた）。
    "categories": { "correctness": "off" },

    // 整形規則は 1 つも入れない —— **整形は人が持つ**（#296）。
    // ★ oxlint には indent / quotes / semi / max-len が**存在しない**（同日実測）ので、
    //   「明示的に off にする」対象そのものが無い。整形器は oxfmt という**別パッケージ**で、
    //   ここには入れていない（#316 が Biome を却下した理由は、そちらが整形器を兼ねること）。
    // ★ 自動修正のフラグは配管に置かない。package.json のどのスクリプトにも書かない。
    "rules": {
        "no-var": "warn",
        "no-redeclare": "warn",
        "no-unused-vars": "warn",
        "no-implicit-globals": "warn"
    }
}
