// grabado が生成した Prisma のスキーマ。
//
// **native type 属性（@db.Uuid / @db.VarChar）は出さない** —— provider ごとに別の表が
// 要り、正規型 1 段で写すという設計（段階6-9c）と噛み合わないため。uuid は String に、
// date / time / timestamp は DateTime に丸まる。丸めた列にはその旨のコメントが付く。
//
// **Prisma の識別子は ASCII だけ**なので、非 ASCII の名前は `_` に潰して通し番号で
// 一意化してある。**元の名前は @@map / @map に必ず残る**。
//
// **datasource は出していない** —— h2 に対応する Prisma の provider が無い。
// 使うときは対応する provider の datasource を自分で足すこと。

model TypeSample {
  cInteger Int? @map("c_integer")
  cSmallint Int? @map("c_smallint")
  cTinyint Int? @map("c_tinyint")
  cBigint BigInt? @map("c_bigint")
  cBigintIdentity BigInt @id @default(autoincrement()) @map("c_bigint_identity")
  cDecimal Decimal? @map("c_decimal")
  cFloat Float? @map("c_float")
  cDouble Float? @map("c_double")
  cDecfloat Decimal? @map("c_decfloat")
  cChar String? @map("c_char")
  cVarchar String? @map("c_varchar")
  cText String? @map("c_text")
  cBytea Bytes? @map("c_bytea")
  cVarbinary Bytes? @map("c_varbinary")
  cBoolean Boolean? @map("c_boolean")
  cDate DateTime? @map("c_date")
  cTime DateTime? @map("c_time")
  cTimeTz DateTime? @map("c_time_tz")
  cTimestampTz DateTime? @map("c_timestamp_tz")
  cUuid String? @map("c_uuid")
  cJson Json? @map("c_json")
  // geometry: Prisma のスカラーに対応が無いので String で出す（GEOMETRY）
  cGeometry String? @map("c_geometry")

  @@map("type_samples")
}