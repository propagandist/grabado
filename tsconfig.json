{
  // js/ src/ tests/ のすべてが .ts（§3 段階3-3b で js/ の .js が尽きた）。
  // checkJs は落とした（型検査すべき .js がもう無い）。allowJs だけ残すのは
  // vitest.config.ts が scripts/canonical-cwd.mjs を import しているため。
  "compilerOptions": {
    "allowJs": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["frontend/js/**/*.ts", "frontend/src/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
