# === OS ===
.DS_Store
Thumbs.db

# === IDE / エディタ ===
.idea/
# ★ `.vscode/` ではなく `.vscode/*` と書く —— **ディレクトリごと除外すると、中の 1 本を
#   再包含できない**（git の仕様。2026-09-12 に踏んだ）。
.vscode/*
# ★ 例外を 1 本だけ追跡する（#296）。**エディタの自動整形を切る設定は、配らないと効かない**
#   —— 2026-09-12 に保存時整形が 1 ファイルを全面再インデントした（828 挿入 / 808 削除、
#   うち実質 37 行）。grabado は整形を人が持つので、**機械に整形させない設定のほうを配る**。
!.vscode/settings.json
*.iml

# === Node / Vite ===
node_modules/
# Vite の出力だけを無視する。階層無制限の "dist/" にすると
# tests/dist/（配布物スモークのテストコード）まで巻き込む。
# 段階2-6 で root が frontend/ になったので、出力もそこへ出る。
/frontend/dist/
.vite/
*.local

# === Java / Gradle（server/。段階5-1b で実体が入った） ===
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
# VSCode の Kotlin / Java 拡張が作る Eclipse 系のビルド出力。Gradle は使わない。
/server/bin/

# === 環境変数・秘密（イメージに焼かず env 注入。CLAUDE.md §5,§7） ===
.env
.env.*
!.env.example
# wwwsqldesigner 由来の実設定（config.xml.sample はテンプレとして追跡）
config.xml

# === テスト成果物（HANDOVER §7）===
# golden（tests/golden/）は追跡対象。以下は実行時の一時出力のみ
test-results/
# E2E の正本ディレクトリ（段階5-9。実ファイルに書くので一時ディレクトリを本物として使う）
tests/tmp-schema/
# イメージ E2E が mount するディレクトリ（段階2-4。compose.e2e.yaml が右辺を差し替える）
tests/tmp-image-schema/
playwright-report/
blob-report/
.playwright/

# === ログ・一時 ===
*.log

# Claude Code の手元固有の設定（org work-conventions「commit する側と、しない側」）。
# ★ ここに書くのは、**リポジトリの外で守られていた**から（2026-08-30 実測 —— 除外していたのは
#   作業者のグローバル gitignore で、**作業環境が変われば commit されうる**）。
# .claude/settings.json と .claude/hooks/ は commit する（関門は配る先でも同じであるべき）。
.claude/settings.local.json

