    "rationale": "監査列 created_at / updated_at が無い。house 既定は timestamptz NOT NULL DEFAULT now()。",
    "patch": {
      "op": "add-column",
      "name": "created_at",
      "sqlType": "TIMESTAMPTZ",
      "nullable": false,
      "default": "now()"
    }
  },
  {
