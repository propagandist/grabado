<?xml version="1.0" encoding="utf-8" ?>
<!--
  特性化テスト fixture: house 既定（HANDOVER §6）を SQL Server の型パレットで表したもの。
  postgresql 版と同じスキーマ（tests/fixtures/postgresql/house-defaults.xml）を、
  db/mssql/datatypes.xml に実在する型だけで書き直してある。

  **house 既定が SQL Server で失うもの**（記録は CUSTOMIZATIONS.md 段階6-6b）:
    - uuid            -> **uniqueidentifier がある**（4 プロファイルで唯一。生成は NEWID()）
    - timestamptz     -> datetime（tz を保持しない。datetimeoffset はパレットに無い）
    - jsonb           -> nvarchar(4000)（JSON 型が無い。制約で検証する運用）
    - boolean         -> bit
    - date            -> **datetime**（日付だけの型がパレットに無い。足すのは 6-8）

  **mssql の timestamp は行バージョンであって日時ではない**（rowversion の別名）。
  監査列に使うと意味が変わるので datetime を使う —— types-matrix の c_timestamp が
  その型そのものを押さえている。

  型名がすべて小文字なのはパレットの sql が小文字だから（types-matrix の注記を参照）。
-->
<sql>
<table x="20" y="20" name="users">
<row name="id" null="0" autoincrement="0">
<datatype>uniqueidentifier</datatype>
<default>NEWID()</default>
</row>
<row name="email" null="0" autoincrement="0">
<datatype>nvarchar(255)</datatype>
<comment>ログイン用メールアドレス</comment>
</row>
<row name="display_name" null="0" autoincrement="0">
<datatype>nvarchar(255)</datatype>
</row>
<row name="is_active" null="0" autoincrement="0">
<datatype>bit</datatype>
<default>1</default>
</row>
<row name="preferences" null="0" autoincrement="0">
<datatype>nvarchar(4000)</datatype>
<default>{}</default>
<comment>UI 設定などの任意項目</comment>
</row>
<row name="created_at" null="0" autoincrement="0">
<datatype>datetime</datatype>
<default>GETDATE()</default>
</row>
<row name="updated_at" null="0" autoincrement="0">
<datatype>datetime</datatype>
<default>GETDATE()</default>
</row>
<key type="PRIMARY" name="users_pkey">
<part>id</part>
</key>
<key type="UNIQUE" name="users_email_key">
<part>email</part>
</key>
<comment>ユーザー</comment>
</table>
<table x="420" y="20" name="articles">
<row name="id" null="0" autoincrement="0">
<datatype>uniqueidentifier</datatype>
<default>NEWID()</default>
</row>
<row name="author_id" null="0" autoincrement="0">
<datatype>uniqueidentifier</datatype>
<relation table="users" row="id" />
<comment>執筆者 (users.id)</comment>
</row>
<row name="title" null="0" autoincrement="0">
<datatype>nvarchar(255)</datatype>
</row>
<row name="body" null="1" autoincrement="0">
<datatype>nvarchar(4000)</datatype>
</row>
<row name="view_count" null="0" autoincrement="0">
<datatype>int</datatype>
<default>0</default>
</row>
<row name="price" null="1" autoincrement="0">
<datatype>decimal(12,2)</datatype>
<comment>有料記事の価格。money ではなく decimal を使う</comment>
</row>
<row name="published_on" null="1" autoincrement="0">
<datatype>datetime</datatype>
</row>
<row name="created_at" null="0" autoincrement="0">
<datatype>datetime</datatype>
<default>GETDATE()</default>
</row>
<row name="updated_at" null="0" autoincrement="0">
<datatype>datetime</datatype>
<default>GETDATE()</default>
</row>
<key type="PRIMARY" name="articles_pkey">
<part>id</part>
</key>
<comment>記事</comment>
</table>
<table x="820" y="20" name="article_tags">
<row name="article_id" null="0" autoincrement="0">
<datatype>uniqueidentifier</datatype>
<relation table="articles" row="id" />
</row>
<row name="tag" null="0" autoincrement="0">
<datatype>nvarchar(64)</datatype>
</row>
<row name="created_at" null="0" autoincrement="0">
<datatype>datetime</datatype>
<default>GETDATE()</default>
</row>
<key type="PRIMARY" name="pk_article_tags">
<part>article_id</part>
<part>tag</part>
</key>
<comment>記事とタグの対応</comment>
</table>
</sql>
