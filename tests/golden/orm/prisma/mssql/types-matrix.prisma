// grabado が生成した Prisma のスキーマ。
//
// **native type 属性（@db.Uuid / @db.VarChar）は出さない** —— provider ごとに別の表が
// 要り、正規型 1 段で写すという設計（段階6-9c）と噛み合わないため。uuid は String に、
// date / time / timestamp は DateTime に丸まる。丸めた列にはその旨のコメントが付く。
//
// **Prisma の識別子は ASCII だけ**なので、非 ASCII の名前は `_` に潰して通し番号で
// 一意化してある。**元の名前は @@map / @map に必ず残る**。

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model TypeSample {
  cInteger Int @id @map("c_integer")
  cSmallint Int? @map("c_smallint")
  cTinyint Int? @map("c_tinyint")
  cBigint BigInt? @map("c_bigint")
  cDecimal Decimal? @map("c_decimal")
  cFloat Float? @map("c_float")
  cReal Float? @map("c_real")
  cChar String? @map("c_char")
  cVarchar String? @map("c_varchar")
  cNchar String? @map("c_nchar")
  cNvarchar String? @map("c_nvarchar")
  cBoolean Boolean? @map("c_boolean")
  cBinary Bytes? @map("c_binary")
  cVarbinary Bytes? @map("c_varbinary")
  cDate DateTime? @map("c_date")
  cTime DateTime? @map("c_time")
  cDatetime DateTime? @map("c_datetime")
  cDatetime2 DateTime? @map("c_datetime2")
  cDatetimeoffset DateTime? @map("c_datetimeoffset")
  cSmalldatetime DateTime? @map("c_smalldatetime")
  cUuid String? @map("c_uuid")
  // xml: Prisma のスカラーに対応が無いので String で出す（xml）
  cXml String? @map("c_xml")
  // other: Prisma のスカラーに対応が無いので String で出す（sql_variant）
  cSqlVariant String? @map("c_sql_variant")
  // other: Prisma のスカラーに対応が無いので String で出す（rowversion）
  cRowversion String? @map("c_rowversion")
  // other: Prisma のスカラーに対応が無いので String で出す（hierarchyid）
  cHierarchyid String? @map("c_hierarchyid")
  // geometry: Prisma のスカラーに対応が無いので String で出す（geometry）
  cGeometry String? @map("c_geometry")

  @@map("type_samples")
}